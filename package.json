{
   "name": "backpack-vite",
   "private": true,
   "version": "0.0.0",
   "type": "module",
   "scripts": {
      "dev": "concurrently \"npm run client:dev\" \"npm run server:dev\"",
      "client:dev": "vite",
      "client:build": "vite build",
      "client:preview": "vite preview",
      "server:dev": "nodemon --exec ncc run server/index.ts",
      "server:build": "ncc build --out dist/server server/index.ts",
      "test": "vitest",
      "lint": "eslint",
      "typecheck": "vue-tsc --noEmit"
   },
   "dependencies": {
      "@trpc/client": "^11.4.3",
      "@trpc/server": "^11.4.3",
      "express": "^5.1.0",
      "pg": "^8.14.1",
      "pinia": "^3",
      "reflect-metadata": "^0.2.2",
      "tailwindcss": "^4.0.9",
      "vue": "^3.5",
      "vue-router": "^4"
   },
   "devDependencies": {
      "@eslint/js": "^9",
      "@tailwindcss/vite": "^4.0.9",
      "@types/express": "^5.0.3",
      "@types/node": "^22.13.10",
      "@types/pg": "^8.15.4",
      "@vercel/ncc": "^0.38.3",
      "@vitejs/plugin-vue": "^6",
      "@vue/test-utils": "^2",
      "concurrently": "^9.2.0",
      "eslint": "^9",
      "eslint-plugin-vue": "^10",
      "globals": "^15",
      "jsdom": "^26",
      "nodemon": "^3.1.10",
      "typescript": "5.8.3",
      "typescript-eslint": "^8",
      "vite": "^6",
      "vitest": "^3",
      "vue-tsc": "^3"
   }
}
